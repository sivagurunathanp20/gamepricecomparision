# Copy this file to .env and fill in real values before running in production.

SECRET_KEY=change-this-to-a-long-random-string

# Leave DATABASE_URL unset to use the bundled SQLite database (zero setup).
# For MySQL, uncomment and edit:
# DATABASE_URL=mysql+pymysql://gamevault_user:yourpassword@localhost:3306/game_deals_db

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
# Set to 0 to actually send price-alert emails once MAIL_USERNAME/PASSWORD are real
MAIL_SUPPRESS_SEND=1

# Optional — powers the "Vault" AI chatbot with real Claude answers instead
# of keyword matching. Get a free key at https://console.anthropic.com/
# Leave blank and the chatbot still works, just with simpler rule-based replies.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional — CheapShark (Steam/Epic/GOG/Humble/Fanatical/GMG/EA/Ubisoft
# prices) already works with NO key needed, no setup required here.
# This key adds IsThereAnyDeal as a SECOND price source on top of that,
# for extra store coverage. Get a free key at https://isthereanydeal.com/apps/
ITAD_API_KEY=

# Optional — enables the "Sign in with Google" button on Login/Register.
# Leave both blank to skip Google Sign-In entirely; the app works exactly
# as before with just email/password accounts.
#
# Setup:
#   1. https://console.cloud.google.com/apis/credentials
#   2. Create Credentials -> OAuth client ID -> Application type: Web application
#   3. Authorized redirect URI: http://127.0.0.1:5000/auth/google/callback
#      (add your real domain's equivalent URL too when you deploy)
#   4. Copy the generated Client ID and Client Secret below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match Google Cloud Console exactly (127.0.0.1 ≠ localhost).
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/google/callback

# ---- Official price verification (all optional; defaults shown) ----
# Region of the official storefront whose prices are displayed.
STORE_COUNTRY=IN
STORE_LOCALE=en-IN
# Hide any price not re-verified against the official store within this many minutes.
PRICE_MAX_AGE_MINUTES=720
PRICE_REFRESH_MINUTES=120
REFRESH_ON_VIEW_MINUTES=30
PROBE_PURCHASE_URLS=1
# 1 = also list games whose price could not be verified (shown as "Unable to verify price")
SHOW_UNVERIFIED_GAMES=0